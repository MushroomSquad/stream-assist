    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "repository": {
    "type": "git",
